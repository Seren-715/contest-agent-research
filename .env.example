# 参赛队名（同时用于 data/<team>/ 与 data/figure/<team>/）
CONTEST_TEAM=你的队伍名

# 工作区根目录。平台通常把 /output 作为根，本地默认当前目录。
CONTEST_WORKSPACE_ROOT=.

# 平台注入的统一模型接口（OpenAI-compatible）
PLATFORM_LLM_URL=
PLATFORM_API_KEY=
PLATFORM_LLM_MODEL=

# 本地开发：没有模型时返回可预测的占位结果，不用于正式提交
CONTEST_MOCK_LLM=0

# D 类平台客户端（正式环境是 /data/experiments/run_experiment.py）
CONTEST_D_CLIENT=/data/experiments/run_experiment.py
CONTEST_D_MATERIALS_ROOT=/data/experiments

# D 类本地自测与失败回修
CONTEST_D_SELFTEST=1
CONTEST_D_REPAIR_ATTEMPTS=1
CONTEST_D_SELFTEST_TIMEOUT=8
# D 类模型单次生成/修复的输出预算。推理型模型 16k 会被截断，默认 64k。
CONTEST_D_MAX_TOKENS=64000
# 给正式实验入口预留的秒数；自测/修复不得吃掉这段时间。
CONTEST_D_FORMAL_RESERVE=70
# 不填则依次尝试 <materials>/公开样例请求、<materials>/../公开样例请求、vendor/d-class/公开样例请求
# CONTEST_D_SAMPLES_ROOT=

# 单题预算（秒）
CONTEST_CASE_BUDGET=900
# A/B 外层上限 540 秒，C/D/E 900 秒；override 只能缩短。
# CONTEST_CASE_TIMEOUT_MS=
CONTEST_FINALIZE_RESERVE=10
CONTEST_REQUEST_TIMEOUT=300
